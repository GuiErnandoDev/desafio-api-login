# Copie este arquivo para ".env" e ajuste a senha do seu MySQL.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=pi_web

# Login (JWT)
# JWT_SECRET: texto longo e secreto usado para assinar os tokens. Troque por qualquer frase grande.
JWT_SECRET=troque-por-uma-frase-longa-e-secreta
# Validade do access_token em segundos (3600 = 1 hora)
JWT_EXPIRES_IN=3600
